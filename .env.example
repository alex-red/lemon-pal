# Copy to .env.local and fill in. Never commit real values.

# PayPal Sandbox REST app credentials: https://developer.paypal.com/dashboard/applications/sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
# Leave as sandbox for the hackathon build.
PAYPAL_ENV=sandbox

# Currency for every sale (one currency per stand for now).
STAND_CURRENCY=USD

# Vision model API key for reading price-sign photos.
ANTHROPIC_API_KEY=

# Optional: AG Studio licence key for the stand recap. Without it, Studio runs with a watermark.
AG_STUDIO_LICENSE_KEY=

# SQLite database file. Defaults to .data/lemonpal.sqlite. On Render, point it at the persistent disk.
DATABASE_PATH=

# Public origin used in sale QR codes, e.g. https://lemonpal.example.com
# Defaults to the request origin when blank. In development on localhost, it defaults to this machine's
# network address, so a phone on the same Wi-Fi can scan the code.
PUBLIC_APP_URL=
